{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biomenu",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
